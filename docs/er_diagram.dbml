// ============================================================================
// HackArena: Database Markup Language (DBML) Source
// Tool compatibility: dbdiagram.io / draw.io DBML import
// Exact match with MySQL 8.4 schema
// ============================================================================

Table admins {
  admin_id int [pk, increment, note: 'Primary Key']
  name varchar(100) [not null]
  email varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table participants {
  participant_id int [pk, increment, note: 'Primary Key']
  name varchar(100) [not null]
  email varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  college varchar(100) [null]
  phone varchar(15) [null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table hackathons {
  hackathon_id int [pk, increment, note: 'Primary Key']
  title varchar(100) [not null]
  description text [null]
  start_date date [not null]
  end_date date [not null]
  registration_deadline date [not null]
  status enum [not null, default: 'Upcoming', note: 'Upcoming, Ongoing, Completed']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'CHECK (registration_deadline <= start_date AND start_date <= end_date)'
}

Table teams {
  team_id int [pk, increment, note: 'Primary Key']
  team_name varchar(100) [not null]
  hackathon_id int [not null, ref: > hackathons.hackathon_id]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  Note: 'UNIQUE (hackathon_id, team_name)'
}

Table team_members {
  team_id int [not null, ref: > teams.team_id]
  participant_id int [not null, ref: > participants.participant_id]
  role enum [not null, default: 'Member', note: 'Leader, Member']
  joined_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (team_id, participant_id) [pk]
  }
}

Table submissions {
  submission_id int [pk, increment, note: 'Primary Key']
  team_id int [unique, not null, ref: - teams.team_id]
  project_title varchar(100) [not null]
  description text [null]
  github_link varchar(255) [null]
  submitted_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  score decimal(5,2) [null]
  feedback text [null]
  evaluated_by int [null, ref: > admins.admin_id]
  status enum [not null, default: 'Pending', note: 'Pending, Evaluated']
  Note: 'CHECK (score BETWEEN 0 AND 100); CHECK status consistency'
}

// Relationships summary:
// 1. hackathons (1) ----- (0..N) teams [ON DELETE RESTRICT]
// 2. teams (1) ----- (1..N) team_members [ON DELETE CASCADE]
// 3. participants (1) ----- (0..N) team_members [ON DELETE RESTRICT]
// 4. teams (1) ----- (0..1) submissions [1-to-1, ON DELETE CASCADE]
// 5. admins (1) ----- (0..N) submissions [ON DELETE RESTRICT]
